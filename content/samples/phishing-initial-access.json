      "event_type": "SUBMIT_DECISION",
      "phase": "lessons_learned",
      "payload": {
        "decision_key": "primary_control_gap",
        "decision_value": "mail_gateway_policy",
        "rationale": "The gateway is the earliest point where one configuration change stops the whole chain. The other gaps are real but further down and harder to close without breaking legitimate work."
      },
      "created_at": "2025-05-06T09:40:50.000Z",
      "prev_hash": "3bd2c2d22c844f0653d3a067bc104a78f30154793493fbf73507758c4d673cdf",
