    {
      "id": "sample-ransomware-outbreak-0049",
      "session_id": "sample-ransomware-outbreak",
      "user_id": "sample-user-ransomware-outbreak",
      "event_type": "SUBMIT_REPORT",
      "phase": "lessons_learned",
      "payload": {
        "reflection": {
          "what_happened": "A ransomware incident affecting Northwind Polytechnic. Incident INC-2025-0311 was closed on 11 March after blocking the command-and-control domain at the web proxy, but the affected workstation was never isolated or rebuilt, the Run-key persistence was never removed, the user's credentials were never reset, and the domain was never blocked at DNS or the firewall. The implant remained on WKS-HR-014 for seven days. On 18 March it launched at logon, resolved the same C2 domain through a path that had not been blocked, downloaded a ransomware payload, deleted shadow copies, stopped backup and database services, and encrypted the workstation and every share it had a mapped drive to.",
          "what_worked": "Detection telemetry gave us the incident early enough to contain it before the attacker achieved their objective, and the evidence available was sufficient to establish the root cause without guesswork.",
          "what_to_change": "The controls that failed are the ones closest to the initial access, and fixing those is worth more than adding another layer of detection further down the chain.",
          "recommended_controls": [
            "Require that any host with confirmed code execution is rebuilt from a known-good image before it returns to service, with an explicit named exception process rather than an informal one.",
            "Block confirmed C2 indicators at every layer - DNS, proxy and firewall - and verify the block from the affected host rather than assuming it applied.",
            "Define closure criteria for incidents that include eradication of persistence and credential rotation, so a ticket cannot be closed while the implant is still resident."
          ]
        },
        "executive_summary": "A ransomware incident affecting Northwind Polytechnic. Incident INC-2025-0311 was closed on 11 March after blocking the command-and-control domain at the web proxy, but the affected workstation was never isolated or rebuilt, the Run-key persistence was never removed, the user's credentials were never reset, and the domain was never blocked at DNS or the firewall. The implant remained on WKS-HR-014 for seven days. On 18 March it launched at logon, resolved the same C2 domain through a path that had not been blocked, downloaded a ransomware payload, deleted shadow copies, stopped backup and database services, and encrypted the workstation and every share it had a mapped drive to."
      },
      "created_at": "2025-05-07T10:41:00.000Z",
      "prev_hash": "fbfe9801e9bece05bd95c553f067237e98324bb784b9e5926d6a3fee9ce1ba72",
