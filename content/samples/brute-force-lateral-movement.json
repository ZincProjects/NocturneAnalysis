    {
      "id": "sample-brute-force-lateral-movement-0043",
      "session_id": "sample-brute-force-lateral-movement",
      "user_id": "sample-user-brute-force-lateral-movement",
      "event_type": "SUBMIT_DECISION",
      "phase": "lessons_learned",
      "payload": {
        "decision_key": "primary_control_gap",
        "decision_value": "unreviewed_perimeter_rule",
        "rationale": "The gateway is the earliest point where one configuration change stops the whole chain. The other gaps are real but further down and harder to close without breaking legitimate work."
      },
      "created_at": "2025-05-07T10:33:41.000Z",
      "prev_hash": "1934c09ff3f4b6eb87ffb8c214a11177ec31f4ebf1b6d831586440d538e2c127",
      "hash": "4b38d4748648d64f4de0fddb2a707c53383d6b442e7d5b24ed999059d3f1af36",
      "client_meta": null
    },
    {
      "id": "sample-brute-force-lateral-movement-0044",
      "session_id": "sample-brute-force-lateral-movement",
      "user_id": "sample-user-brute-force-lateral-movement",
      "event_type": "SUBMIT_REPORT",
      "phase": "lessons_learned",
      "payload": {
        "reflection": {
          "what_happened": "A network incident affecting Northwind Polytechnic. A firewall rule created as a temporary measure in March 2021 left RDP exposed to the entire internet and was never reviewed or removed. An attacker sprayed passwords against it and succeeded on svc_helpdesk - a service account with a password unchanged since 2019, no MFA, membership of Server Operators, and an explicit exemption from the account lockout policy. From there they used built-in Windows tooling to move to a file server, archived the academic records share, and uploaded it over HTTPS.",
          "what_worked": "Detection telemetry gave us the incident early enough to contain it before the attacker achieved their objective, and the evidence available was sufficient to establish the root cause without guesswork.",
          "what_to_change": "The controls that failed are the ones closest to the initial access, and fixing those is worth more than adding another layer of detection further down the chain.",
          "recommended_controls": [
            "Remove the Remote-Access-Legacy firewall rule and place all remote access behind the VPN with MFA; no service should be reachable from the whole internet.",
            "Introduce a scheduled review of perimeter rules with a mandatory expiry date on anything created as temporary.",
            "Deny interactive and RemoteInteractive logon to service accounts through group policy, so a stolen service credential cannot be used at a keyboard."
          ]
        },
        "executive_summary": "A network incident affecting Northwind Polytechnic. A firewall rule created as a temporary measure in March 2021 left RDP exposed to the entire internet and was never reviewed or removed. An attacker sprayed passwords against it and succeeded on svc_helpdesk - a service account with a password unchanged since 2019, no MFA, membership of Server Operators, and an explicit exemption from the account lockout policy. From there they used built-in Windows tooling to move to a file server, archived the academic records share, and uploaded it over HTTPS."
      },
      "created_at": "2025-05-07T10:35:14.000Z",
