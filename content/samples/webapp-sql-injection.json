    {
      "id": "sample-webapp-sql-injection-0044",
      "session_id": "sample-webapp-sql-injection",
      "user_id": "sample-user-webapp-sql-injection",
      "event_type": "SUBMIT_REPORT",
      "phase": "lessons_learned",
      "payload": {
        "reflection": {
          "what_happened": "A web incident affecting Northwind Polytechnic. The student portal builds SQL by concatenating user input directly into query strings, in both the search handler and the login handler. The application also runs with DEBUG enabled in production, so failed queries returned the offending SQL statement, the ORM library and the framework version to the attacker - turning a blind probe into a guided one. Once the login query was understood, a comment character removed the password comparison, and the portal's administrator account had no second factor to fall back on.",
          "what_worked": "Detection telemetry gave us the incident early enough to contain it before the attacker achieved their objective, and the evidence available was sufficient to establish the root cause without guesswork.",
          "what_to_change": "The controls that failed are the ones closest to the initial access, and fixing those is worth more than adding another layer of detection further down the chain.",
          "recommended_controls": [
            "Replace string concatenation with parameterised queries in the search and login handlers, so user input is passed to the driver separately from the statement and can never be parsed as SQL (closes A03).",
            "Set DEBUG to false in the production configuration and return a generic error page, logging the detail server-side only (closes A05).",
            "Enrol the portal administrator account in phishing-resistant MFA, so a bypassed password check is not sufficient on its own (closes A07)."
          ]
        },
        "executive_summary": "A web incident affecting Northwind Polytechnic. The student portal builds SQL by concatenating user input directly into query strings, in both the search handler and the login handler. The application also runs with DEBUG enabled in production, so failed queries returned the offending SQL statement, the ORM library and the framework version to the attacker - turning a blind probe into a guided one. Once the login query was understood, a comment character removed the password comparison, and the portal's administrator account had no second factor to fall back on."
      },
      "created_at": "2025-05-07T10:36:04.000Z",
