# Copy to .env.local for development, and set the same values in the Vercel
# project settings for deployment.

# --------------------------------------------------------------- required --
# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (or legacy anon) key. Safe to expose to the browser: every table
# is protected by Row Level Security, so this key alone grants a visitor only
# what an anonymous visitor is meant to see.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute origin of the deployment. Used to build magic-link redirect URLs, so
# it must match the site URL configured in Supabase Auth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --------------------------------------------------------------- optional --
# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never commit a real value, and
# do not set it in Vercel unless you have a reason to: the application does not
# read it. It is used by the local seeding and sample-generation scripts, and
# by Edge Functions, where Supabase injects it for you.
SUPABASE_SERVICE_ROLE_KEY=

# Playwright end-to-end run. Create this user in the seeded demo organization.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
