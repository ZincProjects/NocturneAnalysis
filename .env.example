# Copy to .env.local for development, and set the same values in the Vercel
# project settings for deployment.

# --------------------------------------------------------------- required --
# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (or legacy anon) key. Safe to expose to the browser: every table
# is protected by Row Level Security, so this key alone grants a visitor only
# what an anonymous visitor is meant to see.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute origin of the deployment. Must match the Site URL configured in
# Supabase Auth, and the origin must be on its redirect allow-list, or links in
# confirmation and sign-in emails will not work.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never commit a real value.
#
# Required for report generation. When a student submits, the score has to be
# computed somewhere they cannot influence and written to tables they cannot
# write to - otherwise a student could POST themselves full marks. That write
# needs the service role.
#
# It is deliberately NOT used for appending events: that path goes through the
# append-event Edge Function, where Supabase injects the key itself and it
# never touches the web server.
#
# Copy it from Dashboard > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------------- optional --
# SERVER ONLY. Passcode for the Nocturne CTF organiser screen at /ctf/admin
# (at least 8 characters). The screen also needs SUPABASE_SERVICE_ROLE_KEY.
# Leave empty to keep the organiser screen switched off.
CTF_ADMIN_PASSCODE=


# `npm run demo:users` creates student@northwind.example and
# instructor@northwind.example and prints fresh passwords. Set these to choose
# the passwords yourself.
DEMO_STUDENT_PASSWORD=
DEMO_INSTRUCTOR_PASSWORD=

# Playwright end-to-end run. The demo student works.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
